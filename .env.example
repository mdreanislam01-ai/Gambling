# ---------------------------------------------------------------------------
# ArenaPlay — environment example. Copy to `.env` and adjust.
# NEVER commit the real `.env`. No secret is ever read by the browser:
# only server code imports src/config.js.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=

# Data
DATA_DIR=./data
DATABASE_FILE=gambling.db

# Security (REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
IP_HASH_SALT=change-me-to-a-random-string
COOKIE_NAME=arenaplay_session
# Leave empty to auto-decide (Secure only over https). Set to 1 behind a TLS proxy.
COOKIE_SECURE=
TRUST_PROXY=0
MAX_BODY_BYTES=262144

# Sessions
SESSION_TTL_DAYS=14
# Brute-force lockout: N consecutive bad passwords freezes the account for M minutes
AUTH_FAIL_MAX=8
AUTH_LOCKOUT_MINUTES=15
PASSWORD_SCRYP_COST_LOG2=15

# Demo / compliance switches. The platform is DEMO ONLY and refuses to boot if
# someone tries to flip real money on (see src/config.js).
DEMO_MODE=true
SIGNUP_BONUS_CENTS=500000
RESET_DAILY_BONUS=1
MAX_DEMO_CREDIT_CENTS=10000000
REAL_MONEY_ENABLED=false

# Responsible gaming defaults (basis: 100 cents = 1 demo credit)
DEFAULT_DAILY_LOSS_LIMIT_CENTS=200000
DEFAULT_SESSION_LIMIT_MIN=60
REALITY_CHECK_EVERY_MIN=20

# Localisation
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn

# Rate limits (per window)
RATE_LOGIN_MAX=10
RATE_LOGIN_WINDOW_S=300
RATE_REGISTER_MAX=5
RATE_REGISTER_WINDOW_S=3600
RATE_BET_MAX=120
RATE_BET_WINDOW_S=60
RATE_WRITE_MAX=60
RATE_WRITE_WINDOW_S=60
RATE_RESET_MAX=5
RATE_RESET_WINDOW_S=900
COOKIE_SAME_SITE=Lax

# Crash game round timing (seconds). Shorter rounds are for demos only.
CRASH_BETTING_SECONDS=8
CRASH_FLYING_SECONDS=24
CRASH_GAP_SECONDS=3

# Sports data provider (OPTIONAL). Live scores are only shown when a licensed
# provider is configured; otherwise the app runs on clearly-labelled DEMO data.
# We never fabricate live scores.
SPORTS_PROVIDER=none
SPORTS_PROVIDER_BASE_URL=
SPORTS_PROVIDER_KEY=
SPORTS_REFRESH_SECONDS=60

# Admin bootstrap (used only by `npm run seed`)
SEED_ADMIN_EMAIL=admin@arenaplay.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin!2026

# Logging
LOG_LEVEL=info
